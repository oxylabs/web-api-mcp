# Oxylabs Web API credentials
OXYLABS_WEB_API_KEY=your_api_key_here

# Optional overrides
OXYLABS_BASE_URL=https://webapi.oxylabs.io
OXYLABS_TIMEOUT=120

# JavaScript rendering runs as a background job the agent polls. Renders take 30-150s
# upstream and the timeout matches that ceiling: one that has not landed by then will not.
OXYLABS_JS_TIMEOUT=150
OXYLABS_JOB_TTL_MINUTES=60

# Below this much visible text, a page fetched without JS is flagged as a shell
OXYLABS_THIN_CONTENT_CHARS=500

# `extract` is billed above a plain scrape, so the user is asked to approve each run.
# Set to 0 only when they have already agreed to the cost.
OXYLABS_EXTRACT_APPROVAL=1

# Large pages: offload to disk (stdio) or truncate (http) above this many tokens.
# Tokens, not characters — 40k chars of English is ~10k tokens but 40k chars of Chinese
# is ~40k, and clients reject a tool result over 25k. A client can override per request
# with an X-MCP-Max-Tokens header or ?max_tokens=; 0 opts out.
OXYLABS_MAX_INLINE_TOKENS=10000
# Chunk size read_scraped returns by default
OXYLABS_READ_CHUNK_CHARS=40000
OXYLABS_SPILL_DIR=/tmp/oxylabs-web-api-mcp
OXYLABS_SPILL_TTL_HOURS=6
# Set to 0 to keep everything inline even on stdio
OXYLABS_SPILL=1

# Retry transient upstream failures (500/502/503/504) before giving up
OXYLABS_RETRIES=2
OXYLABS_RETRY_BASE_DELAY=1

# Cap what this server will spend, e.g. 100/1h or 50/30m. Unset = no limit.
OXYLABS_RATE_LIMIT=

# Only used by the HTTP transport (self-hosting)
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080
# Hostnames this server answers for. Required over HTTP: anything else gets a 421.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Origin allowlist for browser clients. Unset leaves FastMCP's same-origin default.
MCP_ALLOWED_ORIGINS=
